{
  "tenantId": "your-tenant-id (GUID from Entra ID overview)",
  "clientId": "your-application-client-id (GUID from app registration)",
  "clientSecret": "your-client-secret-value (Certificates & secrets -> Value, not Secret ID)",
  "dataDir": "./data",
  "pstDir": "./pst-export",
  "port": 8080,
  "host": "127.0.0.1",
  "scopes": "https://graph.microsoft.com/.default",
  "concurrency": 6,
  "sizeScanConcurrency": 3,
  "maxPstSizeGB": 49,
  "autoResume": true,
  "autoResumeMinutes": 15,
  "newMailCheck": true,
  "newMailCheckMinutes": 60,
  "httpTimeoutMs": 120000,
  "maxExportBytes": 2147483648,
  "pruneDeleted": false,
  "graveyardDeleted": false,
  "diskReserveBytes": 10737418240,
  "graphExchangeExportEnabled": false,
  "pstTimeoutMs": 600000,
  "pstRetryCount": 2,
  "pstWindow": { "from": "00:00", "to": "00:00" },
  "exoTimeoutMs": 600000,
  "exoExportChunkMonths": 6,
  "exoExportRetries": 5,
  "exoExportTimeoutMs": 1800000
}
